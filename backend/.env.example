GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-flash-lite-latest
MAX_ITERATIONS=5
DOCKER_IMAGE=autopatch-sandbox:latest
DOCKER_NODE_IMAGE=autopatch-node-sandbox:latest
SANDBOX_TIMEOUT_SEC=120
SANDBOX_MEM_LIMIT=768m

# Optional — set these to open a real GitHub PR on Approve
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPOSITORY=your-user/Autopatch
# GITHUB_PR_BASE=main
